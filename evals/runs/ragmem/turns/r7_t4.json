 "first_sql": "SELECT \n    NOW() AS `数据统计日期`,\n    '境内ETF总数' AS `统计名称`,\n    COUNT(*) AS `ETF数量`\nFROM \n    ETF_INFO_DETAIL\nWHERE \n    TYPE = 1\n    AND FUND_SYMBOL IS NOT NULL\n    AND FUND_NAME IS NOT NULL\n    AND HISVALID = 1",
