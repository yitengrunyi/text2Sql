 "first_sql": "SELECT \n    COUNT(DISTINCT v.COMB_SYMBOL) AS `美股行情收录总股票数`\nFROM VIEW_US_EOD_EXPR v\nWHERE v.TRADE_DATE = (\n    SELECT MAX(TRADE_DATE)\n    FROM VIEW_US_EOD_EXPR\n    WHERE TRADE_DATE IS NOT NULL\n)",
